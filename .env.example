# Copia este archivo como .env y pega tus claves después del "=".
# El .env está en .gitignore: nunca se sube a GitHub.

# OpenAI: arma la nota con gpt-4.1-mini (y transcribe de respaldo con whisper-1)
OPENAI_API_KEY=

# Groq: transcribe con Whisper large-v3-turbo, unas 9 veces más barato (https://console.groq.com/keys)
GROQ_API_KEY=

# Opcional: modelo para la nota (si no se pone, se usa el del código)
OPENAI_MODEL=
